{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "description": "Bulls and Cows game — functional programming, TDD",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "tsc && node -e \"const fs=require('fs'); fs.copyFileSync('index.html','dist/index.html'); fs.copyFileSync('styles.css','dist/styles.css'); let h=fs.readFileSync('dist/index.html','utf8'); h=h.replace(/\\.\\/dist\\//g,'./'); fs.writeFileSync('dist/index.html',h);\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kalanho/Bulls-and-Cows.git"
  },
  "keywords": [
    "game",
    "functional-programming",
    "tdd"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Kalanho/Bulls-and-Cows/issues"
  },
  "homepage": "https://github.com/Kalanho/Bulls-and-Cows#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "copyfiles": "^2.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
